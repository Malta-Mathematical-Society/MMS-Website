{{- $html := printf "<h1>%s</h1><div>%s</div><p><a href=\"%s\">Read on web</a></p>" .Title .Content .Permalink -}}
{{- $sendEmail := .Params.send_email | default true -}}
{{- dict 
  "guid" .Permalink 
  "title" .Title 
  "lang" .Language.Lang 
  "category" .Type
  "send_email" $sendEmail
  "html_content" $html 
| jsonify -}}